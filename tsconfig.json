{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "./lib/**/*.ts",
    "./lib/**/*.vue",
    "./tests/**/*.ts",
    "./vitest.config.mts"
  ],
  "compilerOptions": {
    "types": ["node", "vue"],
    "rootDir": "./",
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": true
  },
  "vueCompilerOptions": {
    "target": 3.5
  }
}
